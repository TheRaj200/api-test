[Unit]
Description=api-test order API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=apitest
Group=apitest
WorkingDirectory=/opt/api-test

# Replace the password. Keep sslmode=disable only for a local socket/host.
Environment=DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/api_test?sslmode=disable
Environment=PORT=8080
# 6 pooled connections is plenty for 1 vCPU and leaves Postgres headroom.
Environment=DB_MAX_OPEN_CONNS=6
# Hard cap so the Go runtime cannot balloon on a 1 GB machine.
Environment=GOMEMLIMIT=128MiB

ExecStart=/opt/api-test/api-test
Restart=always
RestartSec=2
TimeoutStopSec=15

# Runtime hardening + resource caps
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=256M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
